// ============================================================
// schema.prisma — Pets Post v2
//
// Fonte da verdade: specs/domain/entities.md
//
// IMPORTANTE (Etapa 1): este schema ESPELHA o banco MySQL do
// projeto Flask original (mesmos nomes de tabelas/colunas via
// @map/@@map e mesmos tipos nativos). Assim o banco atual pode
// ser reaproveitado sem migração destrutiva. Melhorias de modelo
// (ex.: unificar tabelas de fotos, FLOAT -> DOUBLE) estão
// planejadas em specs/data/migration-plan.md e entram depois.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMs ----------

enum UserRole {
  admin
  user
}

enum PostStatus {
  lost
  found
}

enum PetType {
  dog
  cat
  bird
  other
}

enum PetSize {
  small
  medium
  large
}

enum PartnerType {
  foster_home
  petshop
  vet_clinic
}

// Loja (Etapa 7b · specs/api/store.md · BR-STORE-002)
enum ProductCategory {
  food
  treats
  toys
  hygiene
  health
  accessories
  beds
}

// ---------- Tabelas ----------

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(120)
  passwordHash String?  @map("password_hash") @db.VarChar(256)
  role         UserRole @default(user)
  phone        String?  @db.VarChar(20)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(256)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  posts         PetPost[]
  adoptionPosts AdoptionPost[]

  @@map("users")
}

model PetPost {
  id               Int        @id @default(autoincrement())
  title            String     @db.VarChar(150)
  description      String     @db.Text
  status           PostStatus @default(lost)
  petName          String?    @map("pet_name") @db.VarChar(100)
  petType          PetType    @map("pet_type")
  petBreed         String?    @map("pet_breed") @db.VarChar(100)
  petColor         String?    @map("pet_color") @db.VarChar(100)
  petSize          PetSize?   @map("pet_size")
  lastSeenLocation String     @map("last_seen_location") @db.VarChar(255)
  lastSeenLat      Float?     @map("last_seen_lat") @db.Double
  lastSeenLng      Float?     @map("last_seen_lng") @db.Double
  contactPhone     String     @map("contact_phone") @db.VarChar(20)
  contactEmail     String?    @map("contact_email") @db.VarChar(120)
  reward           String?    @db.VarChar(100)
  isActive         Boolean    @default(true) @map("is_active")
  isResolved       Boolean    @default(false) @map("is_resolved")
  createdAt        DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime?  @updatedAt @map("updated_at") @db.DateTime(0)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  photos Photo[]

  @@index([userId])
  @@map("pet_posts")
}

model Photo {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(256)
  url       String   @db.VarChar(512)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  postId Int     @map("post_id")
  post   PetPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("photos")
}

model AdoptionPost {
  id                  Int       @id @default(autoincrement())
  title               String    @db.VarChar(150)
  description         String    @db.Text
  petName             String?   @map("pet_name") @db.VarChar(100)
  petType             PetType   @map("pet_type")
  petBreed            String?   @map("pet_breed") @db.VarChar(100)
  petColor            String?   @map("pet_color") @db.VarChar(100)
  petSize             PetSize?  @map("pet_size")
  isNeutered          Boolean   @default(false) @map("is_neutered")
  isVaccinated        Boolean   @default(false) @map("is_vaccinated")
  adopterRequirements String?   @map("adopter_requirements") @db.Text
  location            String    @db.VarChar(255)
  locationLat         Float?    @map("location_lat") @db.Double
  locationLng         Float?    @map("location_lng") @db.Double
  contactPhone        String    @map("contact_phone") @db.VarChar(20)
  contactEmail        String?   @map("contact_email") @db.VarChar(120)
  isActive            Boolean   @default(true) @map("is_active")
  isAdopted           Boolean   @default(false) @map("is_adopted")
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.DateTime(0)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  photos AdoptionPhoto[]

  @@index([userId])
  @@map("adoption_posts")
}

model AdoptionPhoto {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(256)
  url       String   @db.VarChar(512)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  adoptionPostId Int          @map("adoption_post_id")
  adoptionPost   AdoptionPost @relation(fields: [adoptionPostId], references: [id], onDelete: Cascade)

  @@index([adoptionPostId])
  @@map("adoption_photos")
}

model Partner {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(150)
  description String?     @db.Text
  partnerType PartnerType @map("partner_type")
  address     String      @db.VarChar(255)
  lat         Float?      @db.Double
  lng         Float?      @db.Double
  phone       String?     @db.VarChar(20)
  email       String?     @db.VarChar(120)
  website     String?     @db.VarChar(255)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(0)

  products Product[]

  @@map("partners")
}

// Produtos da vitrine (Etapa 7b). Tabelas novas da v2 — não existem no banco do Flask.
// Preço em centavos (BR-STORE-003). Parceiro com produtos não pode ser excluído (BR-STORE-008).
model Product {
  id              Int             @id @default(autoincrement())
  name            String          @db.VarChar(150)
  description     String?         @db.Text
  category        ProductCategory
  petType         PetType?        @map("pet_type")
  priceCents      Int             @map("price_cents")
  promoPriceCents Int?            @map("promo_price_cents")
  stock           Int             @default(0)
  url             String?         @db.VarChar(500)
  isActive        Boolean         @default(true) @map("is_active")
  isFeatured      Boolean         @default(false) @map("is_featured")
  // Quando o preço foi conferido (BR-STORE-011): ao criar, ao mudar o preço e ao "Atualizar do link".
  priceCheckedAt  DateTime?       @map("price_checked_at") @db.DateTime(0)
  createdAt       DateTime        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt       DateTime?       @updatedAt @map("updated_at") @db.DateTime(0)

  partnerId Int     @map("partner_id")
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  photos ProductPhoto[]

  @@index([partnerId])
  @@index([isActive, category])
  @@map("products")
}

model ProductPhoto {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(256)
  url       String   @db.VarChar(512)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_photos")
}

// Sessões do express-session (migration M-05 · specs/api/auth.md).
// Tabela nova da v2 — não existe no banco do sistema antigo.
// `userId` sem FK de propósito: a sessão é cache; serve para "sair de todos os dispositivos".
model Session {
  sid       String   @id @db.VarChar(128)
  data      String   @db.Text
  expiresAt DateTime @map("expires_at") @db.DateTime(0)
  userId    Int?     @map("user_id")

  @@index([expiresAt])
  @@index([userId])
  @@map("sessions")
}
