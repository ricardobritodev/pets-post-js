// ============================================================
// schema.prisma — Pets Post v2
//
// Fonte da verdade: specs/domain/entities.md
//
// IMPORTANTE (Etapa 1): este schema ESPELHA o banco MySQL do
// projeto Flask original (mesmos nomes de tabelas/colunas via
// @map/@@map e mesmos tipos nativos). Assim o banco atual pode
// ser reaproveitado sem migração destrutiva. Melhorias de modelo
// (ex.: unificar tabelas de fotos, FLOAT -> DOUBLE) estão
// planejadas em specs/data/migration-plan.md e entram depois.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- ENUMs ----------

enum UserRole {
  admin
  user
}

enum PostStatus {
  lost
  found
}

enum PetType {
  dog
  cat
  bird
  other
}

enum PetSize {
  small
  medium
  large
}

enum PartnerType {
  foster_home
  petshop
  vet_clinic
}

// ---------- Tabelas ----------

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(120)
  passwordHash String?  @map("password_hash") @db.VarChar(256)
  role         UserRole @default(user)
  phone        String?  @db.VarChar(20)
  avatarUrl    String?  @map("avatar_url") @db.VarChar(256)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(0)

  posts         PetPost[]
  adoptionPosts AdoptionPost[]

  @@map("users")
}

model PetPost {
  id               Int        @id @default(autoincrement())
  title            String     @db.VarChar(150)
  description      String     @db.Text
  status           PostStatus @default(lost)
  petName          String?    @map("pet_name") @db.VarChar(100)
  petType          PetType    @map("pet_type")
  petBreed         String?    @map("pet_breed") @db.VarChar(100)
  petColor         String?    @map("pet_color") @db.VarChar(100)
  petSize          PetSize?   @map("pet_size")
  lastSeenLocation String     @map("last_seen_location") @db.VarChar(255)
  lastSeenLat      Float?     @map("last_seen_lat") @db.Float
  lastSeenLng      Float?     @map("last_seen_lng") @db.Float
  contactPhone     String     @map("contact_phone") @db.VarChar(20)
  contactEmail     String?    @map("contact_email") @db.VarChar(120)
  reward           String?    @db.VarChar(100)
  isActive         Boolean    @default(true) @map("is_active")
  isResolved       Boolean    @default(false) @map("is_resolved")
  createdAt        DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime?  @updatedAt @map("updated_at") @db.DateTime(0)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  photos Photo[]

  @@index([userId])
  @@map("pet_posts")
}

model Photo {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(256)
  url       String   @db.VarChar(512)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  postId Int     @map("post_id")
  post   PetPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("photos")
}

model AdoptionPost {
  id                  Int       @id @default(autoincrement())
  title               String    @db.VarChar(150)
  description         String    @db.Text
  petName             String?   @map("pet_name") @db.VarChar(100)
  petType             PetType   @map("pet_type")
  petBreed            String?   @map("pet_breed") @db.VarChar(100)
  petColor            String?   @map("pet_color") @db.VarChar(100)
  petSize             PetSize?  @map("pet_size")
  isNeutered          Boolean   @default(false) @map("is_neutered")
  isVaccinated        Boolean   @default(false) @map("is_vaccinated")
  adopterRequirements String?   @map("adopter_requirements") @db.Text
  location            String    @db.VarChar(255)
  locationLat         Float?    @map("location_lat") @db.Float
  locationLng         Float?    @map("location_lng") @db.Float
  contactPhone        String    @map("contact_phone") @db.VarChar(20)
  contactEmail        String?   @map("contact_email") @db.VarChar(120)
  isActive            Boolean   @default(true) @map("is_active")
  isAdopted           Boolean   @default(false) @map("is_adopted")
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.DateTime(0)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  photos AdoptionPhoto[]

  @@index([userId])
  @@map("adoption_posts")
}

model AdoptionPhoto {
  id        Int      @id @default(autoincrement())
  filename  String   @db.VarChar(256)
  url       String   @db.VarChar(512)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  adoptionPostId Int          @map("adoption_post_id")
  adoptionPost   AdoptionPost @relation(fields: [adoptionPostId], references: [id], onDelete: Cascade)

  @@index([adoptionPostId])
  @@map("adoption_photos")
}

model Partner {
  id          Int         @id @default(autoincrement())
  name        String      @db.VarChar(150)
  description String?     @db.Text
  partnerType PartnerType @map("partner_type")
  address     String      @db.VarChar(255)
  lat         Float?      @db.Float
  lng         Float?      @db.Float
  phone       String?     @db.VarChar(20)
  email       String?     @db.VarChar(120)
  website     String?     @db.VarChar(255)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(0)

  @@map("partners")
}
