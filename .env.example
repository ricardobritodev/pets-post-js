# ============================================================
# Copie para .env:  cp .env.example .env
# ============================================================

# Ambiente: development | test | production
NODE_ENV=development

# Porta da API Express
API_PORT=3000

# Conexão MySQL usada pelo Prisma
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL=mysql://petpost_user:petpost123@localhost:3306/petpost_v2

# Chave para assinar o cookie de sessão (mín. 32 caracteres)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais

# Produção: endereço público (og:url/og:image) e pasta do build do front
# PUBLIC_URL=https://www.petspost.com.br
# WEB_DIST_DIR=apps/web/dist

# Fotos enviadas (padrão: apps/api/uploads). Em produção, aponte para um volume com backup.
# UPLOAD_DIR=/var/lib/petspost/uploads

# Geocodificação (Nominatim/OpenStreetMap). Ligada por padrão, menos nos testes.
# GEOCODER_ENABLED=false
# User-Agent identificado é exigido pela política do Nominatim.
# GEOCODER_USER_AGENT=PetsPost/2.0 (projeto-academico; contato: seu-email@exemplo.com)

# Botão flutuante "Fale com a gente" (WhatsApp do Pets Post). Sem número, o botão não aparece.
# CONTACT_WHATSAPP=(11) 91234-5678
# CONTACT_WHATSAPP_MESSAGE=Olá! Vim pelo site do Pets Post e gostaria de ajuda.
